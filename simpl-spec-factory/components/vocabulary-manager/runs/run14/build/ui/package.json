{
  "name": "vocabulary-manager-ui",
  "version": "1.0.0",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,vue}\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"tests/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "keycloak-js": "26.2.5",
    "n3": "2.13.12",
    "primevue": "5.0.5",
    "vue": "3.5.46",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/n3": "1.26.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
