# Physical model of the Vocabulary Manager store (D87): SHACL shapes of each named graph.
#
# Named graphs in the dataset 'vocabulary':
#   <urn:simpl:vocabulary-manager:graph:internal>          vocabularies (vm:InternalVocabulary) and versions
#                                                           (vm:InternalVocabularyVersion)
#   <urn:simpl:vocabulary-manager:graph:external>          external vocabularies (vm:ExternalVocabulary) and their
#                                                           alias URIs (vm:AliasUri)
#   <urn:simpl:vocabulary-manager:content:<Name>:<n>>       content of one vocabulary version (vm:ContentChunk)
#   <urn:simpl:vocabulary-manager:external-content:<Name>>  content of one external vocabulary (vm:ContentChunk)
#
# The build's own test (PhysicalModelShapesTest) runs these shapes against data stored through the API.

PREFIX sh:  <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX vm:  <https://simpl-open.eu/ns/vocabulary-manager#>

vm:InternalVocabularyShape a sh:NodeShape ;
    sh:targetClass vm:InternalVocabulary ;
    sh:property [ sh:path vm:name ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[A-Z][a-zA-Z0-9]{2,63}$" ] ;
    sh:property [ sh:path vm:nameKey ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vm:status ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "ACTIVE" "DEPRECATED" ) ] ;
    sh:property [ sh:path vm:latestVersion ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:minInclusive 1 ] ;
    sh:property [ sh:path vm:creationDate ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vm:lastUpdateDate ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vm:createdBy ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vm:changeToken ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .

vm:InternalVocabularyVersionShape a sh:NodeShape ;
    sh:targetClass vm:InternalVocabularyVersion ;
    sh:property [ sh:path vm:vocabulary ; sh:class vm:InternalVocabulary ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vm:version ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:minInclusive 1 ] ;
    sh:property [ sh:path vm:description ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:minLength 1 ; sh:maxLength 1000 ] ;
    sh:property [ sh:path vm:changelog ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:minLength 1 ; sh:maxLength 1000 ] ;
    sh:property [ sh:path vm:status ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "ACTIVE" "DEPRECATED" ) ] ;
    sh:property [ sh:path vm:creationDate ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vm:lastUpdateDate ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vm:createdBy ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vm:contentGraph ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vm:contentSha256 ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:property [ sh:path vm:contentSize ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:minInclusive 0 ; sh:maxInclusive 5242880 ] .

vm:ExternalVocabularyShape a sh:NodeShape ;
    sh:targetClass vm:ExternalVocabulary ;
    sh:property [ sh:path vm:name ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[A-Z][a-zA-Z0-9]{2,63}$" ] ;
    sh:property [ sh:path vm:nameKey ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vm:namespaceUri ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vm:namespaceKey ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vm:aliasList ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vm:alias ; sh:class vm:AliasUri ; sh:maxCount 20 ] ;
    sh:property [ sh:path vm:sourceUri ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path vm:description ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:maxLength 1000 ] ;
    sh:property [ sh:path vm:createdBy ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vm:creationDate ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vm:contentGraph ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vm:changeToken ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .

vm:AliasUriShape a sh:NodeShape ;
    sh:targetClass vm:AliasUri ;
    sh:property [ sh:path vm:index ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
    sh:property [ sh:path vm:uri ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path vm:key ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .

vm:ContentChunkShape a sh:NodeShape ;
    sh:targetClass vm:ContentChunk ;
    sh:property [ sh:path vm:chunkIndex ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:minInclusive 0 ; sh:maxInclusive 100 ] ;
    sh:property [ sh:path vm:chunkData ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[A-Za-z0-9+/=]*$" ] .
