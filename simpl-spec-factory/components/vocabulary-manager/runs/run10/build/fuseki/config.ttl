# Fuseki services of the Vocabulary Manager store (E3, D83, Q3).
#   vocabulary          the live dataset: query for the read, update and admin users, update for the update user,
#                       whole-dataset Graph Store Protocol (backup and restore) for the admin user only.
#   vocabulary-restore  the staging dataset of the restore procedure (Q3), admin user only.
# Users and passwords come from the environment (entrypoint.sh). No anonymous access.
PREFIX :        <#>
PREFIX fuseki:  <http://jena.apache.org/fuseki#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX tdb2:    <http://jena.apache.org/2016/tdb#>

:service rdf:type fuseki:Service ;
    fuseki:name "vocabulary" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "query" ; fuseki:allowedUsers ("reader" "writer" "admin") ] ;
    fuseki:endpoint [ fuseki:operation fuseki:update ; fuseki:name "update" ; fuseki:allowedUsers ("writer") ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-rw ; fuseki:name "data" ; fuseki:allowedUsers ("admin") ] ;
    fuseki:dataset :vocabularyDataset .

:vocabularyDataset rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases/vocabulary" .

:restore rdf:type fuseki:Service ;
    fuseki:name "vocabulary-restore" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "query" ; fuseki:allowedUsers ("admin") ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-rw ; fuseki:name "data" ; fuseki:allowedUsers ("admin") ] ;
    fuseki:dataset :restoreDataset .

:restoreDataset rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases/vocabulary-restore" .
