@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cpsv: <https://example.org/vm/{{run}}/cpsv#> .

cpsv:PublicService a owl:Class ;
    rdfs:label "Public Service"@en ;
    rdfs:comment "A CPSV-like class used to show that a core public service vocabulary can be uploaded."@en .

cpsv:hasCompetentAuthority a owl:ObjectProperty ;
    rdfs:domain cpsv:PublicService ;
    rdfs:range cpsv:PublicOrganisation .

cpsv:PublicOrganisation a owl:Class ;
    rdfs:label "Public Organisation"@en .
