# Fuseki configuration of the Vocabulary Manager store (decisions E3, D83, D106, D156).
# No anonymous access: every request needs one of the three users of the password file.
#   reader: SPARQL query only (backend reads)
#   writer: SPARQL query and update (backend writes)
#   admin : query and dataset read (backup script) and the compaction endpoint
PREFIX fuseki: <http://jena.apache.org/fuseki#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX tdb2:   <http://jena.apache.org/2016/tdb#>

[] rdf:type fuseki:Server ;
   fuseki:passwd "/fuseki/run/passwd" ;
   fuseki:allowedUsers "reader", "writer", "admin" .

<#service> rdf:type fuseki:Service ;
    fuseki:name "vocabulary" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ;  fuseki:name "query" ;  fuseki:allowedUsers ("reader" "writer" "admin") ] ;
    fuseki:endpoint [ fuseki:operation fuseki:update ; fuseki:name "update" ; fuseki:allowedUsers ("writer") ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-r ;  fuseki:name "data" ;   fuseki:allowedUsers ("admin") ] ;
    fuseki:dataset <#dataset> .

<#dataset> rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases/vocabulary" .
