# Security headers of the UI (D123). KEYCLOAK_URL is filled in at container start.
add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${KEYCLOAK_URL}; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-src ${KEYCLOAK_URL}; frame-ancestors 'none'; base-uri 'self'; form-action 'self' ${KEYCLOAK_URL}" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "no-referrer" always;
add_header X-Frame-Options "DENY" always;
