# Downloads return the bytes as uploaded (D29): CRLF line ends and UTF-8 text.
@prefix ex: <https://example.org/{name}/ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ex:CaféConcept a skos:Concept ;
    skos:prefLabel "Café crème brûlée €"@fr .   # trailing spaces and a comment
