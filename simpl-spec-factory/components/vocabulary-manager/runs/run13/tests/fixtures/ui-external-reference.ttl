# One unregistered external namespace: warning externalReferenceSkipped (D12).
@prefix ex: <https://example.org/{name}/ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ext: <https://unregistered-{tok:lower}.example.org/ns#> .

ex:concept skos:prefLabel "Concept"@en ;
    skos:related ext:term .
