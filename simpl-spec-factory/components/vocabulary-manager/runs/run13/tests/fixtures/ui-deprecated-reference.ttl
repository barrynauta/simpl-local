# A reference to version 1 of Ref, which version 2 has deprecated (D11, D47).
@prefix ex: <https://example.org/{name}/ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ref: <{base}/content/{Ref}/versions/1#> .

ex:concept skos:prefLabel "Concept"@en ;
    skos:related ref:term .
