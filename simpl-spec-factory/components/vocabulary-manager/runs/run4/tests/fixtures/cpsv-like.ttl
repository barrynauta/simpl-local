@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix cpsv: <${own}> .

cpsv:PublicService a owl:Class ;
  rdfs:label "Public Service"@en .

cpsv:Channel a owl:Class ;
  rdfs:label "Channel"@en .

cpsv:hasChannel a owl:ObjectProperty ;
  rdfs:domain cpsv:PublicService ;
  rdfs:range cpsv:Channel .

cpsv:processingTime a owl:DatatypeProperty ;
  rdfs:domain cpsv:PublicService ;
  rdfs:range xsd:duration .
