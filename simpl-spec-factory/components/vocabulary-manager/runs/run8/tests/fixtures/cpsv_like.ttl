@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cpsv: <https://example.org/cpsv/${uid}#> .
cpsv:PublicService a owl:Class ;
  rdfs:label "Public Service"@en ;
  rdfs:comment "A public service delivered by a public organisation."@en .
cpsv:Channel a owl:Class ;
  rdfs:label "Channel"@en .
cpsv:hasChannel a owl:ObjectProperty ;
  rdfs:domain cpsv:PublicService ;
  rdfs:range cpsv:Channel .
cpsv:ServiceTypes a skos:ConceptScheme ;
  skos:prefLabel "Service types"@en .
