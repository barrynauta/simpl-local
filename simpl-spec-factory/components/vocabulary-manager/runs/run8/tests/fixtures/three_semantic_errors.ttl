@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <https://example.org/vocab/${uid}#> .
ex:relatedTo a owl:ObjectProperty .
ex:Thing ex:relatedTo "plain literal" .
ex:both a owl:ObjectProperty .
ex:both a owl:DatatypeProperty .
ex:Label a skos:Concept ;
  skos:prefLabel "One"@en ;
  skos:prefLabel "Two"@en .
