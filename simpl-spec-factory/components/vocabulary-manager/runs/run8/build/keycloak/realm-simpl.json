      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "basic",
        "web-origins",
        "acr"
      ],
      "optionalClientScopes": []
    }
  ],
