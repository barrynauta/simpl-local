{
  "name": "vocabulary-manager-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vocabulary Manager UI (Vue 3 + Vite + TypeScript), factory run 7",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,vue}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\""
  },
  "dependencies": {
    "keycloak-js": "26.2.5",
    "n3": "2.13.12",
    "vue": "3.5.45",
    "vue-router": "4.6.5"
  },
  "devDependencies": {
    "@types/n3": "1.26.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "axe-core": "4.14.1",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}
