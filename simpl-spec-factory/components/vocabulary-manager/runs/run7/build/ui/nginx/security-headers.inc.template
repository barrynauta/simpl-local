# Security headers, included in every location (add_header is not inherited when a location sets its own).
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "no-referrer" always;
add_header X-Frame-Options "DENY" always;
add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${KEYCLOAK_PUBLIC_URL}; frame-src ${KEYCLOAK_PUBLIC_URL}; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' ${KEYCLOAK_PUBLIC_URL}; frame-ancestors 'none'" always;

