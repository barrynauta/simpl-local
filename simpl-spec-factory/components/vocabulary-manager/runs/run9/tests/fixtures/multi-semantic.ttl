@prefix ex: <https://example.org/vm/${run}/multi#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
ex:partOf a owl:ObjectProperty .
ex:subject ex:partOf "invalid-literal" .
ex:c a skos:Concept ;
  skos:prefLabel "One"@en , "Two"@en .
ex:A a owl:Class .
ex:B a owl:Class .
ex:A owl:disjointWith ex:B .
ex:x a ex:A , ex:B .
