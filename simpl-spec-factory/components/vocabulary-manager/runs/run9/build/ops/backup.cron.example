# Daily backup at 02:30 UTC of the vocabulary store (Q3: daily, RPO 24 h). Install with crontab -e on the host
# that runs the stack; BACKUP_COPY_TARGET must point outside the host.
30 2 * * * cd /opt/vocabulary-manager && BACKUP_COPY_TARGET=backup@vault.example:/srv/vm-backups/ ops/backup.sh >> /var/log/vm-backup.log 2>&1
