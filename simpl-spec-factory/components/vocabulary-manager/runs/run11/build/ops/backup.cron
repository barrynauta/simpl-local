# Example schedule (D89): daily backup at 02:30 UTC with a copy outside the host. Installing it is an
# operations task. In Kubernetes use the equivalent CronJob (schedule "30 2 * * *").
30 2 * * * cd /opt/vocabulary-manager && BACKUP_COPY_TARGET=backup-host:/srv/backups/vocabulary-manager ops/backup.sh >> /var/log/vm-backup.log 2>&1
