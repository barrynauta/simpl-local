# Physical model of the Vocabulary Manager store (D87): SHACL shapes of the four named graphs of the
# Fuseki dataset 'vocabulary'. The build's own test (StoredDataShapesIT) runs them against stored data.
#   urn:simpl:vm:graph:internal           vocabularies and vocabulary versions (metadata)
#   urn:simpl:vm:graph:internal-content   content bytes of each vocabulary version
#   urn:simpl:vm:graph:external           external vocabularies (metadata, lookup keys)
#   urn:simpl:vm:graph:external-content   content bytes of each external vocabulary
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix vm:  <https://w3id.org/simpl/vocabulary-manager#> .

vm:Status sh:in ( "ACTIVE" "DEPRECATED" ) .

vm:InternalVocabularyShape a sh:NodeShape ;
  sh:targetClass vm:InternalVocabulary ;
  sh:nodeKind sh:IRI ;
  sh:pattern "^urn:simpl:vm:vocabulary:[A-Z][a-zA-Z0-9]{2,63}$" ;
  sh:property [ sh:path vm:name ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:pattern "^[A-Z][a-zA-Z0-9]*$" ; sh:minLength 3 ; sh:maxLength 64 ] ;
  sh:property [ sh:path vm:nameKey ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path vm:status ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "ACTIVE" "DEPRECATED" ) ] ;
  sh:property [ sh:path vm:latestVersion ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path vm:createdBy ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path vm:creationDate ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path vm:lastUpdateDate ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path vm:writeId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path vm:creationWriteId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path vm:statusWriteId ; sh:datatype xsd:string ; sh:maxCount 1 ] .

vm:InternalVocabularyVersionShape a sh:NodeShape ;
  sh:targetClass vm:InternalVocabularyVersion ;
  sh:nodeKind sh:IRI ;
  sh:property [ sh:path vm:vocabulary ; sh:class vm:InternalVocabulary ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path vm:version ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
  sh:property [ sh:path vm:description ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ] ;
  sh:property [ sh:path vm:changelog ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ] ;
  sh:property [ sh:path vm:status ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "ACTIVE" "DEPRECATED" ) ] ;
  sh:property [ sh:path vm:createdBy ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path vm:creationDate ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path vm:lastUpdateDate ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path vm:creationWriteId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path vm:statusWriteId ; sh:datatype xsd:string ; sh:maxCount 1 ] .

vm:ContentShape a sh:NodeShape ;
  sh:targetSubjectsOf vm:content ;
  sh:nodeKind sh:IRI ;
  sh:property [ sh:path vm:content ; sh:datatype xsd:base64Binary ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path vm:contentLength ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:minInclusive 0 ; sh:maxInclusive 5242880 ] .

vm:ExternalVocabularyShape a sh:NodeShape ;
  sh:targetClass vm:ExternalVocabulary ;
  sh:nodeKind sh:IRI ;
  sh:property [ sh:path vm:name ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[A-Z][a-zA-Z0-9]*$" ] ;
  sh:property [ sh:path vm:nameKey ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path vm:namespaceUri ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path vm:lookupKey ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 21 ] ;
  sh:property [ sh:path vm:sourceUri ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
  sh:property [ sh:path vm:description ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:maxLength 1000 ] ;
  sh:property [ sh:path vm:createdBy ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path vm:creationDate ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path vm:writeId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path vm:alias ; sh:maxCount 20 ; sh:node vm:AliasShape ] .

vm:AliasShape a sh:NodeShape ;
  sh:property [ sh:path vm:index ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
  sh:property [ sh:path vm:uri ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path vm:key ; sh:maxCount 0 ] .
