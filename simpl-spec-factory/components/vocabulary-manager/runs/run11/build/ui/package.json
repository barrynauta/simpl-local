{
  "name": "vocabulary-manager-ui",
  "version": "1.0.0",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && npm run format:check && npm run typecheck && npm run test && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings=0 src tests",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "keycloak-js": "26.2.5",
    "n3": "2.13.12",
    "vue": "3.5.46",
    "vue-router": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/n3": "1.26.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "jsdom": "27.4.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}
