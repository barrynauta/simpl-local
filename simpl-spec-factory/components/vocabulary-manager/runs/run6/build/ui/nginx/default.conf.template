# Serves the UI and proxies the API (the UI uses the same public API as any client, MACH-04).
server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    client_max_body_size 12m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ${KEYCLOAK_URL}; frame-src ${KEYCLOAK_URL}; frame-ancestors 'none'; base-uri 'self'; form-action 'self' ${KEYCLOAK_URL}" always;

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 200 '{"keycloakUrl":"${KEYCLOAK_URL}","realm":"${KEYCLOAK_REALM}","clientId":"${KEYCLOAK_CLIENT_ID}"}';
    }

    location /v1/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ${KEYCLOAK_URL}; frame-src ${KEYCLOAK_URL}; frame-ancestors 'none'; base-uri 'self'; form-action 'self' ${KEYCLOAK_URL}" always;
        try_files $uri /index.html;
    }
}
