{
  "realm": "simpl",
  "enabled": true,
  "displayName": "Simpl-Open (local evaluation)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 30,
  "maxFailureWaitSeconds": 300,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      { "name": "GA_VOCABULARY_ADMIN", "description": "Governance Authority: read and write vocabularies (decision D16)" },
      { "name": "GA_VOCABULARY_VIEWER", "description": "Governance Authority: read vocabularies (decision D16)" }
    ]
  },
  "clientScopes": [
    {
      "name": "vocabulary-manager-audience",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "audience vocabulary-manager-be",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "vocabulary-manager-be",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "user.attribute": "foo",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": ["basic", "roles", "profile", "email", "vocabulary-manager-audience"],
  "clients": [
    {
      "clientId": "vocabulary-manager-be",
      "name": "Vocabulary Manager backend (audience only)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "vocabulary-manager-ui",
      "name": "Vocabulary Manager UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:4433/*"],
      "webOrigins": ["http://localhost:4433"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4433/*"
      },
      "defaultClientScopes": ["basic", "roles", "profile", "email", "vocabulary-manager-audience"]
    },
    {
      "clientId": "vocabulary-tests",
      "name": "Vocabulary Manager test client (password grant, local evaluation only)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["basic", "roles", "profile", "email", "vocabulary-manager-audience"]
    }
  ],
  "users": [
    {
      "username": "ga-admin",
      "email": "ga-admin@example.com",
      "emailVerified": true,
      "firstName": "Governance",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "Password1!", "temporary": false }],
      "realmRoles": ["GA_VOCABULARY_ADMIN"]
    },
    {
      "username": "ga-viewer",
      "email": "ga-viewer@example.com",
      "emailVerified": true,
      "firstName": "Governance",
      "lastName": "Viewer",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "Password1!", "temporary": false }],
      "realmRoles": ["GA_VOCABULARY_VIEWER"]
    },
    {
      "username": "ga-norole",
      "email": "ga-norole@example.com",
      "emailVerified": true,
      "firstName": "Governance",
      "lastName": "Norole",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "Password1!", "temporary": false }],
      "realmRoles": []
    }
  ]
}
