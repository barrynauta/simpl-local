@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <https://vocab.example.org/{run}/syntax#> .

ex:Twice a skos:Concept ;
  skos:prefLabel "One"@en , "Two"@en .
ex:Scheme a skos:ConceptScheme ;
  skos:prefLabel "Scheme"@en .
ex:Broken a skos:Concept ; skos:prefLabel "Broken"@en ex:Oops .
