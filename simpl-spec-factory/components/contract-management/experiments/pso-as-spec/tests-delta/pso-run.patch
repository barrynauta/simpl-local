+@step('the problem body follows the error rules of D11')
+def problem_rules(context):
+    """D11 (PSO run): a JSON object; type an absolute URI; title and detail
+    strings; status an integer from 400 to 599 equal to the HTTP status;
+    instance absent, null, or the request path (never an absolute URL)."""
+    resp = context.response
+    body = _json(context)
+    assert isinstance(body, dict), "problem body is not a JSON object: %r" % body
+    ptype = body.get("type")
+    assert isinstance(ptype, str) and re.match(r"^[A-Za-z][A-Za-z0-9+.-]*:\S+$", ptype), \
+        "problem type is not an absolute URI: %r" % ptype
+    for field in ("title", "detail"):
+        assert isinstance(body.get(field), str), "problem %s is not a string: %r" % (field, body)
+    status = body.get("status")
+    assert isinstance(status, int) and not isinstance(status, bool) and 400 <= status <= 599, \
+        "problem status is not an integer from 400 to 599: %r" % status
+    assert status == resp.status_code, "problem status %r != HTTP status %d" % (
+        status, resp.status_code)
+    instance = body.get("instance")
+    if instance is not None:
+        req_path = urlparse(resp.request.url).path
+        assert instance == req_path, "problem instance %r is not the request path %r" % (
+            instance, req_path)
 
 
