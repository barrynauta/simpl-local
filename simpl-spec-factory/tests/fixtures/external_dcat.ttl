@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ext:  <{EXT_NS}> .

<{EXT_NS}> a owl:Ontology ; rdfs:label "Copied external vocabulary (test)" .
ext:Dataset a owl:Class ; rdfs:label "Dataset" .
ext:Document a owl:Class ; rdfs:label "Document" .
