@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:   <{BASE}/{NAME}#> .
@prefix unk:  <https://unregistered.example.org/ns#> .

<{BASE}/{NAME}> a owl:Ontology .

ex:Report a owl:Class ;
    rdfs:subClassOf unk:Document ;
    rdfs:label "Report" .
