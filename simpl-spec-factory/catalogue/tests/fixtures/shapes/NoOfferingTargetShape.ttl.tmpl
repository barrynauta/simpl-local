@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix simpl: <http://w3id.org/gaia-x/simpl#> .

# No top-level shape targets simpl:DataOffering, simpl:ApplicationOffering or simpl:InfrastructureOffering (D58: 400).
simpl:__SHAPE__ a sh:NodeShape ;
  sh:targetClass simpl:ContractTemplate ;
  sh:property [ sh:path simpl:contractTemplateDocument ; sh:datatype xsd:string ; sh:minCount 1 ] .
