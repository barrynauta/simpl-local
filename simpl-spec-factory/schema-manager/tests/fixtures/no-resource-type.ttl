# RESOURCE schema that declares no resource type (D64, PSO test case SIMPL-18293):
# valid Turtle and the D31 default properties, but no sh:NodeShape has an sh:targetClass.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix simpl: <https://simpl-programme.ec.europa.eu/ns/default#> .

<urn:simpl:test:ResourceShape>
    a sh:NodeShape ;
    sh:property [
        sh:path simpl:uuid ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path simpl:version ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
