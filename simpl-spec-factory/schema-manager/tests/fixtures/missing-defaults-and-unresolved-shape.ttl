# Fails the default property stage and would also fail the semantic stage.
# D33: the first failing stage stops processing, so a Default Properties Error.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<urn:simpl:test:ResourceShape>
    a sh:NodeShape ;
    sh:property [
        sh:path dcterms:title ;
        sh:node <urn:simpl:test:NowhereShape>
    ] .
