# The two default properties sit on two different shapes. D32 requires one
# sh:NodeShape that carries every default property, so this fails.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix simpl: <https://simpl-programme.ec.europa.eu/ns/default#> .

<urn:simpl:test:ShapeOne>
    a sh:NodeShape ;
    sh:property [ sh:path simpl:uuid ; sh:datatype xsd:string ] .

<urn:simpl:test:ShapeTwo>
    a sh:NodeShape ;
    sh:property [ sh:path simpl:version ; sh:datatype xsd:string ] .
