# sh:node and sh:qualifiedValueShape refer to shapes not defined here (D35.3).
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix simpl: <https://simpl-programme.ec.europa.eu/ns/default#> .

<urn:simpl:test:ResourceShape>
    a sh:NodeShape ;
    sh:property [ sh:path simpl:uuid ; sh:datatype xsd:string ] ;
    sh:property [ sh:path simpl:version ; sh:datatype xsd:string ; sh:node <urn:simpl:test:NowhereShape> ] ;
    sh:property [
        sh:path simpl:version ;
        sh:qualifiedValueShape <urn:simpl:test:AlsoNowhereShape> ;
        sh:qualifiedMinCount 1
    ] .
