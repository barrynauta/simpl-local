# SEARCH schema with a reference into a local vocabulary that does not exist (D37).
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:simpl:test:SearchShape>
    a sh:NodeShape ;
    sh:property [ sh:path <$NS$VOCX#title> ; sh:datatype xsd:string ] .
