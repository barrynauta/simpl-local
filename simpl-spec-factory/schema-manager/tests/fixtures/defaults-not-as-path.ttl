# The default property IRIs appear, but not as sh:path of a sh:property (D32).
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix simpl: <https://simpl-programme.ec.europa.eu/ns/default#> .

<urn:simpl:test:ResourceShape>
    a sh:NodeShape ;
    sh:targetClass simpl:uuid ;
    sh:property [ sh:path simpl:version ; sh:datatype xsd:string ] .
