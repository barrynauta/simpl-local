# Several semantic errors at once: all must be returned (SIMPL-22407, D35).
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix simpl: <https://simpl-programme.ec.europa.eu/ns/default#> .

<urn:simpl:test:ResourceShape>
    a sh:NodeShape ;
    sh:property [ sh:path simpl:uuid ; sh:datatype xsd:string ] ;
    sh:property [ sh:path simpl:version ; sh:datatype xsd:string ] ;
    sh:property [ sh:path <$NS$VOCX#owner> ; sh:datatype xsd:string ] ;
    sh:property [ sh:path <$NS$VOC#missingProperty> ; sh:datatype xsd:string ] ;
    sh:property [ sh:path simpl:uuid ; sh:node <urn:simpl:test:NowhereShape> ] .
