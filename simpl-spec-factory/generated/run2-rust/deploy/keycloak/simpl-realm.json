{
  "realm": "simpl",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 1800,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "GA_VOCABULARY_ADMIN",
        "description": "Vocabulary management: read and write"
      },
      {
        "name": "GA_VOCABULARY_VIEWER",
        "description": "Vocabulary management: read only"
      }
    ]
  },
  "clients": [
    {
      "clientId": "vocabulary-tests",
      "name": "Vocabulary Manager test harness",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "realm roles as top-level roles claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "vocabulary-ui",
      "name": "Vocabulary Manager UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:4333/*",
        "http://localhost:4323/*"
      ],
      "webOrigins": [
        "http://localhost:4333",
        "http://localhost:4323"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4333/*##http://localhost:4323/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles as top-level roles claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ga-admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "email": "ga-admin@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": [
        "default-roles-simpl",
        "GA_VOCABULARY_ADMIN"
      ]
    },
    {
      "username": "ga-viewer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Viewer",
      "lastName": "User",
      "email": "ga-viewer@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": [
        "default-roles-simpl",
        "GA_VOCABULARY_VIEWER"
      ]
    },
    {
      "username": "ga-norole",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Norole",
      "lastName": "User",
      "email": "ga-norole@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": [
        "default-roles-simpl"
      ]
    }
  ]
}