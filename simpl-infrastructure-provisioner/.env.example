# Namespace for the whole stack
NS=provisioner

# Source checkout to copy from (no git needed). Override to use another path.
SRC_DIR=../../gitlab/development/infrastructure/infrastructure-provisioner

# Storage
# STORAGE_CLASS=local-path   # autodetected default SC if unset
GITEA_VOLUME_SIZE=2Gi

# Gitea admin (created by the dependencies chart via gitea-secret)
GITEA_USERNAME=gitea_admin
GITEA_PASSWORD=local-gitea-pass

# ArgoCD CRDs: false because this cluster already has ArgoCD CRDs
# (pre-existing argocd namespace). Set true on a pristine cluster.
ARGO_CD_CRDS_INSTALL=false

# Cloud provider credentials: DELIBERATELY dummy. The experiment measures how
# far the control plane gets without real cloud accounts. Do not put real
# tokens here unless you intend to provision real (paid) cloud resources.
IONOS_TOKEN=dummy-local-ionos-token
OVH_APPLICATION_KEY=dummy
OVH_APPLICATION_SECRET=dummy
OVH_CONSUMER_KEY=dummy
OVH_ENDPOINT=ovh-eu

# Kafka for the Argo Events sources. Without --with-kafka this stays a
# non-resolving endpoint and the event sources are EXPECTED to fail (finding).
# KAFKA_ENDPOINT=kafka.local.invalid:9092
KAFKA_USERNAME=local-user
KAFKA_PASSWORD=local-pass

# Chart version to substitute for upstream's ${PROJECT_RELEASE_VERSION}
CHART_VERSION=1.2.1-local
